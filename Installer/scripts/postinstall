#!/bin/bash
set -euo pipefail

pkill -x ScreenSaverEngine 2>/dev/null || true
pkill -x legacyScreenSaver 2>/dev/null || true
pkill -x "legacyScreenSaver-x86_64" 2>/dev/null || true

ACTUAL_USER=$(stat -f "%Su" /dev/console)
if [[ -n "$ACTUAL_USER" && "$ACTUAL_USER" != "root" ]]; then
    sudo -u "$ACTUAL_USER" open "x-apple.systempreferences:com.apple.Wallpaper-Settings.extension" || true
fi

exit 0
